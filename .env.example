APP_NAME=Kotak
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# The local MySQL 8.4 from compose.yaml (docker compose up -d --wait), which
# reads these values too. They are for your own machine only; a server gets
# its own. If port 3306 is taken, set DB_PORT and FORWARD_DB_PORT to the same
# free port before the first start.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kotak
DB_USERNAME=kotak
DB_PASSWORD=secret
# FORWARD_DB_PORT=3306

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Live delivery progress over Laravel Reverb (WebSockets). composer run dev
# starts the Reverb server on port 8080. These values are for your own
# machine only; a server gets its own (see docs/deploy-aws-ec2.md). The
# frontend's build needs the same key, host, port and scheme as
# VITE_REVERB_* in its own .env. BROADCAST_CONNECTION=log writes the
# messages to the log instead, without a Reverb server.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=kotak
REVERB_APP_KEY=kotak-local-key
REVERB_APP_SECRET=kotak-local-secret
# Where Laravel sends the messages to Reverb.
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
# Where the Reverb server listens (reverb:start).
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
# Pages may connect from the host of APP_URL; list others here, comma separated.
# REVERB_ALLOWED_ORIGINS=localhost,127.0.0.1
# Reverb takes at most this many open pages at once, and closes a connection
# that sends more than this many messages a minute (a page sends one or two).
# REVERB_APP_MAX_CONNECTIONS=5000
# REVERB_APP_RATE_LIMIT_MAX_ATTEMPTS=30

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Sends every email to this one address (mail to the demo accounts' @kotak.test
# addresses is otherwise skipped).
# MAIL_TO_ADDRESS=
# Set to false to send no email to receivers (the addresses customers give
# for delivery updates, which nobody confirms).
# RECEIVER_EMAILS=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Where the frontend repository is checked out (the feature tests look for
# its Vue pages). Defaults to ../kotak-parcel-frontend.
# FRONTEND_PATH=../kotak-parcel-frontend
